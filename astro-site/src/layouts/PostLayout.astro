---
import Base from './Base.astro';
import HeroBackground from '@/components/HeroBackground.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import TagList from '@/components/TagList.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  heroImage?: string;
  headings: Heading[];
  readingTime: number;
}

const {
  title,
  description,
  date,
  author,
  tags = [],
  heroImage,
  headings,
  readingTime,
} = Astro.props;
---
<Base title={title} description={description}>
  <HeroBackground image={heroImage} title={title} />

  <div class="max-w-5xl mx-auto px-4 py-10 flex gap-10">
    <!-- Main article -->
    <article class="min-w-0 flex-1">
      <header class="mb-8 pb-6 border-b border-neutral-200 dark:border-neutral-800">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500 dark:text-neutral-400 mb-2">
          {date && (
            <time>
              {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          )}
          {author && <span>by {author}</span>}
          {readingTime > 0 && <span>{readingTime} min read</span>}
        </div>
        <TagList tags={tags} />
      </header>

      <div class="prose prose-neutral dark:prose-invert max-w-none
                  prose-headings:scroll-mt-20
                  prose-a:text-primary-600 dark:prose-a:text-primary-400
                  prose-code:before:content-none prose-code:after:content-none">
        <slot />
      </div>
    </article>

    <!-- TOC sidebar -->
    {headings.length > 0 && (
      <aside class="hidden lg:block w-56 xl:w-64 shrink-0">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</Base>
