---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <div class="flex flex-wrap gap-1.5 mt-3">
    {tags.map(tag => (
      <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}
         class="text-xs bg-neutral-100 dark:bg-neutral-800 hover:bg-primary-100 dark:hover:bg-primary-900/40 text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 px-2.5 py-1 rounded-full transition-colors">
        {tag}
      </a>
    ))}
  </div>
)}
