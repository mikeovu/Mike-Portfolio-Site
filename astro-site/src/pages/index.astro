---
import Base from '@/layouts/Base.astro';
---
<Base title="Mike Vu — Solutions Engineer">
  <div class="relative h-screen -mt-14 flex items-center justify-center">
    <img
      src="/images/Mountain-HQ.jpg"
      alt="Mountain background"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/55"></div>

    <div class="relative z-10 flex flex-col items-center text-center text-white px-4">
      <img
        src="/images/mike_vu.png"
        alt="Mike Vu"
        class="w-28 h-28 rounded-full object-cover border-4 border-white/40 mb-5 shadow-xl"
      />
      <h1 class="text-4xl sm:text-6xl font-bold mb-3 drop-shadow-lg">Mike Vu</h1>
      <p class="text-xl sm:text-2xl text-neutral-200 mb-8">Solutions Engineer</p>
      <div class="flex gap-4">
        <a href="/posts/"
           class="px-6 py-2.5 bg-primary-600 hover:bg-primary-500 rounded-lg font-medium transition-colors shadow-lg">
          View Posts
        </a>
        <a href="/about/"
           class="px-6 py-2.5 bg-white/10 hover:bg-white/20 border border-white/30 rounded-lg font-medium transition-colors backdrop-blur-sm">
          About Me
        </a>
      </div>
    </div>
  </div>
</Base>
