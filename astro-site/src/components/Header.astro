---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'Home', shortLabel: 'Home', href: '/' },
  { label: 'Professional Experience', shortLabel: 'Experience', href: '/about/' },
  { label: 'Projects and Posts', shortLabel: 'Posts', href: '/posts/' },
];

const currentPath = Astro.url.pathname;
---
<header class="fixed top-0 inset-x-0 z-50 bg-neutral-50/80 dark:bg-neutral-900/80 backdrop-blur-sm border-b border-neutral-200/50 dark:border-neutral-800/50">
  <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/" class="font-bold text-lg text-primary-600 dark:text-primary-400 hover:text-primary-500 dark:hover:text-primary-300 transition-colors">
      Mike Vu
    </a>

    <div class="flex items-center gap-1">
      {navLinks.map(link => (
        <a href={link.href}
           class:list={[
             'px-2 py-1.5 sm:px-3 rounded-lg text-xs sm:text-sm font-medium transition-colors',
             currentPath === link.href || currentPath.startsWith(link.href === '/' ? '/~NOMATCH~' : link.href)
               ? 'bg-neutral-200 dark:bg-neutral-700 text-neutral-900 dark:text-neutral-100'
               : 'hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300'
           ]}>
          <span class="sm:hidden">{link.shortLabel}</span>
          <span class="hidden sm:inline">{link.label}</span>
        </a>
      ))}

      <button id="search-open" aria-label="Search (Cmd+K)"
              class="p-1.5 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors text-neutral-600 dark:text-neutral-300 ml-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>

      <ThemeToggle />
    </div>
  </nav>
</header>
<div class="h-14"></div>
