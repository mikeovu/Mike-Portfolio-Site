---
interface Props {
  image?: string;
  title?: string;
  showTitle?: boolean;
}
const { image, title, showTitle = true } = Astro.props;
const src = image ?? '/images/Mountain-HQ.jpg';
---
<div class="relative h-64 md:h-80 overflow-hidden -mt-14">
  <img
    src={src}
    alt={title ?? 'Hero background'}
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/10"></div>

  {showTitle && title && (
    <div class="absolute inset-0 flex items-center justify-center pt-14">
      <h1 class="text-white text-2xl md:text-4xl font-bold text-center px-8 drop-shadow-lg max-w-3xl">
        {title}
      </h1>
    </div>
  )}
</div>
