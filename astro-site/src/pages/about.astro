---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import profilePic from '@/assets/mike_vu.png';

const experience = [
  {
    company: 'Palo Alto Networks',
    title: 'Solutions Consultant 2 – AI Strategics',
    location: 'San Francisco, CA',
    period: '2025 – Present',
    bullets: [
      'Serves as a technical sales advisor for strategic AI accounts, supporting the full Palo Alto Networks product portfolio.',
      'Pre-sales responsibilities span account outreach, technical discovery, demos, architectural whiteboarding, BOM generation, POVs, 1:many trainings, and customer-facing QBRs.',
      'Post-sales responsibilities include deployment validation, support escalations, and expansion discussions.',
      'Internal accomplishments include leveraging tools such as Claude Code to build a sales hub for the district, creating self-guided demos and capture-the-flag sandboxes, and leading internal enablement trainings on AI runtime security.',
    ],
  },
  {
    company: 'runZero',
    title: 'Sales Engineer',
    location: 'San Francisco, CA',
    period: '2024 – 2025',
    bullets: [
      'Provided technical pre-sales support for commercial Mid-Market and West Coast SLED account teams.',
      'Delivered technical demos, developed POV plans and success criteria, and supported self-guided customer trials.',
      'Represented runZero at industry events including SecureWorld Seattle and BSides San Francisco.',
      'Engaged across Attack Surface Management, Asset Management, Vulnerability Management, and OT/ICS/SCADA environments, leveraging tools such as Tenable Nessus and Metasploit.',
    ],
  },
  {
    company: 'Cisco Meraki',
    title: 'Pre-Sales Solutions Engineer',
    location: 'San Francisco, CA',
    period: '2019 – 2024',
    bullets: [
      'Served as technical advisor to enterprise customers evaluating Meraki cloud-managed networking.',
      'Led proof-of-concept deployments covering switching, wireless, security appliances, and IoT.',
      'Built automation demos using the Meraki Dashboard API and Python to accelerate customer adoption.',
    ],
  },
  {
    company: 'Stitch Fix',
    title: 'Network Engineer',
    location: 'San Francisco, CA',
    period: '2018 – 2019',
    bullets: [
      'Managed campus and data center network infrastructure supporting rapid e-commerce growth.',
      'Implemented network segmentation and security policies across distributed fulfillment centers.',
    ],
  },
  {
    company: 'Roche',
    title: 'Network Engineer',
    location: 'San Francisco, CA',
    period: '2016 – 2018',
    bullets: [
      'Supported global WAN and LAN infrastructure for pharmaceutical research and manufacturing environments.',
      'Administered Cisco routing, switching, and wireless platforms across multiple sites.',
    ],
  },
  {
    company: 'Coursera',
    title: 'Network Administrator',
    location: 'Mountain View, CA',
    period: '2014 – 2016',
    bullets: [
      'Built and maintained corporate network infrastructure during a period of high growth.',
      'Earned CCNA certification while in this role, establishing network engineering as a long-term career path.',
    ],
  },
  {
    company: 'Google',
    title: 'IT Contractor',
    location: 'Mountain View, CA',
    period: '2012 – 2014',
    bullets: [
      'Provided IT systems support across campus, configuring and troubleshooting network switches, media servers, and end-user machines.',
    ],
  },
];

const certifications = [
  {
    name: 'Palo Alto Networks Certified Network Security Professional',
    issuer: 'Palo Alto Networks',
    expires: '2028',
  },
  {
    name: 'Zscaler Zero Trust Certified Associate',
    issuer: 'Zscaler',
    expires: '2027',
    verifyUrl: 'https://verify.skilljar.com/c/gyntwfp8zexf',
  },
  {
    name: 'Certified Wireless Network Administrator (CWNA)',
    issuer: 'CWNP',
    expires: '2027',
  },
  {
    name: 'Cisco Certified Network Associate (CCNA)',
    issuer: 'Cisco',
    expires: '2027',
    verifyUrl: 'https://cp.certmetrics.com/cisco/en/public/verify/credential/5EFD2EGHFL1Q1PWQ',
  },
  {
    name: 'Cisco Certified DevNet Associate',
    issuer: 'Cisco',
    expires: '2027',
    verifyUrl: 'https://cp.certmetrics.com/cisco/en/public/verify/credential/WKE1CF0P3GVE1554',
  },
  {
    name: 'ICS Cybersecurity Evaluation (401 Virtual)',
    issuer: 'CISA',
    expires: null,
    date: 'Feb 2025',
  },
];

const skills = [
  {
    category: 'Network Security',
    items: ['Palo Alto Networks NGFW', 'Prisma Access', 'Zero Trust Architecture', 'Cisco Meraki MX', 'Attack Surface Management', 'Vulnerability Management', 'Tenable Nessus', 'Metasploit', 'OT / ICS / SCADA', 'SAML / SSO'],
  },
  {
    category: 'Networking',
    items: ['Routing & Switching', 'Wireless (802.11)', 'SD-WAN', 'Network Segmentation', 'WAN / LAN Design', 'ThousandEyes'],
  },
  {
    category: 'Cloud & Infrastructure',
    items: ['AWS', 'Microsoft Azure', 'Terraform', 'Azure Static Web Apps', 'Docker'],
  },
  {
    category: 'Automation & Dev',
    items: ['Python', 'REST APIs', 'Git / GitHub', 'Postman', 'Meraki Dashboard API', 'Linux / Bash'],
  },
];
---
<Base title="Professional Experience" description="Resume and background of Mike Vu — Solutions Consultant 2, AI Strategics at Palo Alto Networks">

  <!-- Hero -->
  <div class="relative h-48 md:h-64 overflow-hidden -mt-14">
    <img src="/images/Mountain-HQ.jpg" alt="Hero" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 to-black/30"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 pb-20">

    <!-- Resume header card -->
    <div class="relative -mt-16 mb-10 bg-white dark:bg-neutral-900 rounded-2xl shadow-xl border border-neutral-200 dark:border-neutral-800 p-6 sm:p-8 flex flex-col sm:flex-row gap-6 items-start sm:items-center">
      <Image
        src={profilePic}
        alt="Mike Vu"
        width={192}
        height={192}
        class="w-24 h-24 rounded-full object-cover border-4 border-white dark:border-neutral-800 shadow-md shrink-0"
      />
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">Mike Vu</h1>
        <p class="text-lg text-primary-600 dark:text-primary-400 font-medium mt-0.5">Solutions Consultant 2 – AI Strategics · Palo Alto Networks</p>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">San Francisco, CA</p>
        <div class="flex flex-wrap gap-3 mt-3">
          <a href="https://linkedin.com/in/mikeovu" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-500 dark:hover:text-primary-400 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            linkedin.com/in/mikeovu
          </a>
          <a href="https://github.com/mikeovu" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-500 dark:hover:text-primary-400 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            github.com/mikeovu
          </a>
          <a href="https://www.mikeavuportfolio.com" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-500 dark:hover:text-primary-400 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
            mikeavuportfolio.com
          </a>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <section class="mb-12">
      <h2 class="section-heading">Summary</h2>
      <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Network and security professional with 10+ years of experience spanning network operations, engineering, and technical pre-sales. Currently a Solutions Consultant 2 – AI Strategics at Palo Alto Networks, advising strategic enterprise accounts on modern security architecture across the full PANW portfolio. Brings deep hands-on expertise in networking, cybersecurity, and cloud infrastructure, with a consistent track record of translating complex technical concepts into clear, compelling customer outcomes.
      </p>
    </section>

    <!-- Experience -->
    <section class="mb-12">
      <h2 class="section-heading">Experience</h2>
      <div class="space-y-8">
        {experience.map((job, i) => (
          <div class="flex gap-4">
            <!-- Timeline dot -->
            <div class="flex flex-col items-center shrink-0 pt-1">
              <div class:list={[
                'w-3 h-3 rounded-full border-2 shrink-0',
                i === 0
                  ? 'bg-primary-500 border-primary-500'
                  : 'bg-white dark:bg-neutral-900 border-neutral-400 dark:border-neutral-600'
              ]}></div>
              {i < experience.length - 1 && (
                <div class="w-px flex-1 bg-neutral-200 dark:bg-neutral-800 mt-1"></div>
              )}
            </div>

            <!-- Content -->
            <div class="pb-2 min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">{job.title}</h3>
                <span class="text-primary-600 dark:text-primary-400 font-medium text-sm">{job.company}</span>
              </div>
              <div class="flex flex-wrap gap-x-3 text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 mb-2">
                <span>{job.period}</span>
                <span>·</span>
                <span>{job.location}</span>
              </div>
              <ul class="space-y-1">
                {job.bullets.map(b => (
                  <li class="flex gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                    <span class="mt-1.5 w-1 h-1 rounded-full bg-neutral-400 dark:bg-neutral-600 shrink-0"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-12">
      <h2 class="section-heading">Skills</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {skills.map(group => (
          <div class="bg-neutral-50 dark:bg-neutral-800/50 rounded-xl p-4 border border-neutral-200 dark:border-neutral-800">
            <h3 class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2">{group.category}</h3>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map(item => (
                <span class="text-xs bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-600 dark:text-neutral-400 px-2.5 py-1 rounded-full">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-12">
      <h2 class="section-heading">Certifications</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {certifications.map(cert => (
          <div class="flex items-start gap-3 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-800/50">
            <svg class="w-5 h-5 text-primary-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
            <div class="min-w-0">
              {cert.verifyUrl ? (
                <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer"
                   class="text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:text-primary-500 dark:hover:text-primary-400 transition-colors leading-snug block">
                  {cert.name}
                </a>
              ) : (
                <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200 leading-snug">{cert.name}</p>
              )}
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
                {cert.issuer}{cert.expires ? ` · Expires ${cert.expires}` : cert.date ? ` · ${cert.date}` : ''}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-12">
      <h2 class="section-heading">Education</h2>
      <div class="flex items-start gap-4 p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-800/50">
        <img src="/images/ucla.png" alt="UCLA" class="w-12 h-12 object-contain shrink-0 rounded" onerror="this.style.display='none'" />
        <div>
          <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">University of California, Los Angeles</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Bachelor of Arts, Political Science · 2005 – 2009</p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Also worked as an AV Technician for the student union during this period.</p>
        </div>
      </div>
    </section>

    <!-- Personal -->
    <section>
      <h2 class="section-heading">Outside Work</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800">
          <img src="/images/family.jpeg" alt="Family" class="w-full h-40 object-cover" onerror="this.style.display='none'" />
          <p class="text-sm text-neutral-600 dark:text-neutral-400 p-3">Family adventures and the outdoors.</p>
        </div>
        <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800">
          <img src="/images/bike.jpeg" alt="Mountain biking" class="w-full h-40 object-cover" onerror="this.style.display='none'" />
          <p class="text-sm text-neutral-600 dark:text-neutral-400 p-3">Avid mountain biker — always chasing new trails.</p>
        </div>
        <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800">
          <img src="/images/drums.jpeg" alt="Drumming" class="w-full h-40 object-cover" onerror="this.style.display='none'" />
          <p class="text-sm text-neutral-600 dark:text-neutral-400 p-3">Drummer for 20+ years. Former touring musician.</p>
        </div>
      </div>
    </section>

  </div>
</Base>

<style>
  .section-heading {
    @apply text-xs font-semibold uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-4 pb-2 border-b border-neutral-200 dark:border-neutral-800;
  }
</style>
